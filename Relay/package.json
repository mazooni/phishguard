{
  "name": "phishguard-relay",
  "version": "0.1.0",
  "private": true,
  "description": "PhishGuard relay (\"doorbell\"): turns Gmail Pub/Sub and Microsoft Graph webhooks into silent APNs pushes. Never sees mail content.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "calls:setup": "node --env-file-if-exists=.env --import tsx scripts/twilio-setup.ts",
    "calls:replay": "node --env-file-if-exists=.env --import tsx scripts/replay-call.ts",
    "calls:export-demo-verdicts": "node --import tsx scripts/export-demo-verdicts.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/websocket": "^11.3.1",
    "apns2": "^12.2.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "google-auth-library": "^11.1.0",
    "twilio": "^6.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
