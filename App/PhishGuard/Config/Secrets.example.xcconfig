// PhishGuard secrets / per-developer configuration.
//
// Copy this file to Secrets.xcconfig (same folder; it is gitignored) and fill in real values.
// scripts/bootstrap.sh performs the copy automatically when Secrets.xcconfig is missing.
// Every key below is exposed to the app through Info.plist (see project.yml) and read by Config/AppConfig.swift.
//
// NOTE: "//" starts a comment in xcconfig files, so URLs must be written as  https:/$()/host  (the empty
// $() breaks up the double slash without changing the value).

// Google OAuth iOS client (Google Cloud Console → Credentials → OAuth client ID, type iOS).
GOOGLE_CLIENT_ID = 1234567890-abcdefghijklmnop.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abcdefghijklmnop

// Pub/Sub topic that Gmail `users.watch` publishes to; the relay subscribes to it (push subscription).
GMAIL_PUBSUB_TOPIC = projects/your-gcp-project/topics/phishguard-gmail

// Microsoft Entra app registration (Application (client) ID). Redirect URI: msauth.$(PRODUCT_BUNDLE_IDENTIFIER)://auth
MS_CLIENT_ID = 00000000-0000-0000-0000-000000000000

// Relay ("doorbell") service. Leave RELAY_BASE_URL as the example value to run without a relay
// (silent pushes disabled; Background App Refresh still works).
RELAY_BASE_URL = https:/$()/relay.example.com
RELAY_API_KEY = replace-me
// Must match RELAY_SALT on the relay. accountKey = SHA256(lowercased(email) + ":" + RELAY_SALT).
RELAY_SALT = replace-me-with-a-long-random-string
