# PhishGuard relay — copy to .env for local development (`.env` is gitignored; `npm run dev`, `npm start`,
# `npm run calls:setup` and `npm run calls:replay` load it). In production set these with `fly secrets set` —
# never bake them into the image. Values already in the shell environment win over this file.
#
# Smallest useful relay (scripted demo calls + the console, no phone, no pushes): fill RELAY_API_KEY and RELAY_SALT,
# set CALLS_ENABLED=true and leave everything else as it is here.

# Listening port and the public HTTPS origin Pub/Sub and Graph will call (no trailing slash).
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# Shared secrets with the iOS app (Secrets.xcconfig RELAY_API_KEY / RELAY_SALT). ≥ 16 characters; use
# `openssl rand -hex 32` for each. RELAY_SALT feeds accountKey = SHA256(lowercased(email) + ":" + RELAY_SALT).
RELAY_API_KEY=replace-me-with-openssl-rand-hex-32
RELAY_SALT=replace-me-with-a-long-random-string

# SQLite location (Fly volume is mounted at /data).
DATA_DIR=./data

# APNs token authentication (Apple Developer → Keys → APNs). OPTIONAL: leave all three key values empty to run
# without APNs (devices still register; every push is skipped and logged). With a key: APNS_KEY_ID and
# APNS_TEAM_ID are 10 characters each (e.g. ABC123DEFG / TEAM123456) and the .p8 goes in EITHER as base64
# (`base64 < AuthKey_ABC123DEFG.p8 | tr -d '\n'`) OR as a path. APNS_BUNDLE_ID is always required — it is the
# app's bundle id and device registration checks it.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_P8_BASE64=
# APNS_KEY_PATH=./AuthKey_ABC123DEFG.p8
APNS_BUNDLE_ID=com.mazooni.PhishGuard

# Google Cloud Pub/Sub authenticated push. OPTIONAL: without PUBSUB_SERVICE_ACCOUNT_EMAIL the Gmail webhook
# answers 503 (Call Guard-only relays need none of this). The email is the push subscription's
# --push-auth-service-account (e.g. phishguard-push@your-gcp-project.iam.gserviceaccount.com); PUBSUB_AUDIENCE
# defaults to "$PUBLIC_BASE_URL/v1/gmail/pubsub" and must equal --push-auth-token-audience.
PUBSUB_SERVICE_ACCOUNT_EMAIL=
# PUBSUB_AUDIENCE=https://relay.example.com/v1/gmail/pubsub

# ---------------------------------------------------------------------------------------------------------
# Call Guard — real-time scam detection on phone calls (docs/CALLS.md). Off unless CALLS_ENABLED=true.
# ---------------------------------------------------------------------------------------------------------
CALLS_ENABLED=false

# Twilio (all three or none). Without Twilio the relay still runs scripted demo calls and the console, but no line
# can be registered and no real or test call can be placed. TWILIO_ACCOUNT_SID starts with AC (34 characters);
# TWILIO_NUMBER is the "guard number" people call, E.164 (e.g. +15551234567). After `npm run dev`, run
# `npm run calls:setup` once to point that number's voice webhook at $PUBLIC_BASE_URL/v1/calls/twilio/voice.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=

# OpenAI. Without a key: Twilio still transcribes (trial-safe path) and verdicts are rules-only.
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
# OPENAI_SCORING_MODEL=gpt-6-luna

# Who turns audio into text: auto (Twilio's own transcription on a Trial account or without an OpenAI key,
# otherwise Media Streams + OpenAI Realtime), or force twilio / openai.
# CALLS_TRANSCRIPTION_SOURCE=auto
# CALLS_TRANSCRIBE_TRACKS=both           # both | caller
# CALLS_ALERT_MIN_LEVEL=medium           # low | medium | high (the app can override per line)
# CALLS_SPOKEN_WARNING_TEXT=This is PhishGuard. This call shows signs of a scam. ...
# CALLS_MODEL_MIN_INTERVAL_MS=3000
# CALLS_MODEL_TRANSCRIPT_CHARS=6000
# CALLS_RETAIN_ENDED_MINUTES=30          # how long an ended call's transcript stays in memory (never on disk)
# CALLS_RETENTION_DAYS=30                # call records (no transcripts) older than this are pruned
# CALLS_DEMO_ENABLED=true                # scripted demo calls (no phone needed)
# CALLS_CONSOLE_ENABLED=true             # operator page at $PUBLIC_BASE_URL/v1/calls/console?key=<CALLS_CONSOLE_KEY>
# CALLS_CONSOLE_KEY=                     # the console's own key (>= 16 chars); unset = RELAY_API_KEY with a warning

# At most one silent push per accountKey per window (seconds).
DEBOUNCE_SECONDS=10

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
